{
  "name": "nota",
  "private": true,
  "version": "0.1.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "verify:assets": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@rive-app/react-canvas": "^4.35.0",
    "@tanstack/react-virtual": "^3.14.13",
    "dexie": "^4.4.6",
    "katex": "^0.18.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
